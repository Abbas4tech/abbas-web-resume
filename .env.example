# Contentful Configuration
# Base URL for Contentful GraphQL API
CONTENTFUL_BASE_URL=https://graphql.contentful.com/content/v1

# Contentful Space ID (required)
CONTENTFUL_SPACE_ID=your_space_id_here

# Contentful Environment ID (defaults to 'master' if not provided)
CONTENTFUL_ENVIRONMENT_ID=development

# Contentful API Key (required)
CONTENTFUL_API_KEY=your_api_key_here
