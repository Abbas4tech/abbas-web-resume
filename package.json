{
  "name": "abbas-web-resume-monorepo",
  "version": "4.1.7",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "ultracite check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.3.3",
    "typescript": "^5",
    "ultracite": "7.1.1"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm dlx ultracite fix",
      "pnpm dlx ultracite fix"
    ]
  }
}
